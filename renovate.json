{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "pin",
  "groupName": "all",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "on the 14 day of the month"
    ],
    "groupName": "all-lock"
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "copy-webpack-plugin"
      ],
      "allowedVersions": "<=9.1.0"
    },
    {
      "matchPackageNames": [
        "env-editor"
      ],
      "allowedVersions": "<=0.5.0"
    },
    {
      "matchPackageNames": [
        "inquirer",
        "@types/inquirer"
      ],
      "allowedVersions": "=8",
      "description": "inquirer 9+ is ESM-only with a new API; snage uses inquirer 8"
    },
    {
      "description": "Keep CI, the Docker image and @types/node on the same Node major (24 LTS); raise it deliberately in one step",
      "matchPackageNames": [
        "node",
        "@types/node"
      ],
      "allowedVersions": "<25"
    },
    {
      "description": "ts-jest 29 supports only typescript <7",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "eslint-plugin-unicorn 57+ requires ESLint 9.20+, but react-scripts pins ESLint 8",
      "matchPackageNames": [
        "eslint-plugin-unicorn"
      ],
      "allowedVersions": "<57"
    }
  ],
  "schedule": [
    "on the 1 day of the month"
  ]
}
